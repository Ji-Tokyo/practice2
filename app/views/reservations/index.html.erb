<h1>Бронь автосервиса</h1>
<ul>
  <% if @reservations.present? %>
    <% @reservations.each do |reservation| %>
    <li>
      <%= reservation.data.strftime("%Y-%m-%d %H:%M") %> - <%= reservation.client.name %>
    </li>
    <% end %>
    <% else %>
      <li>No upcoming bookings.</li>
    <% end %>
</ul>